# Copy this file to `.env` and never commit it. The agents read it; the evidence builder reads only `evidence-builder.env`.
# README.md has the table of the four settings files. DEPLOY.md has the host settings.

# A Sandbox API key (starts with `sanning_test_`), made in the console under Settings, API keys.
SANNING_API_KEY=

# Your model service's key.
OPENAI_API_KEY=
# The model name your service uses; it must support tool calls.
# `openai/gpt-5-mini` is the name on gateways such as the Vercel AI Gateway and OpenRouter.
# On OpenAI itself, set `gpt-5-mini` and leave OPENAI_BASE_URL empty.
MODEL=openai/gpt-5-mini
# Your model service's OpenAI-compatible address; leave it empty for OpenAI.
OPENAI_BASE_URL=

# --- A bucket for the content (optional in the Sandbox, required in Live) ---
# One bucket for both agents; each writes under a folder named after its agent ID.
# SANNING_LOG_BUCKET=
# The bucket's region.
# AWS_REGION=
# Leave this unset on Amazon S3.
# AWS_ENDPOINT_URL_S3=
# Keys that can create and write to the bucket.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Set to true for path-style bucket addresses (https://host/bucket) on Amazon S3.
# SANNING_S3_PATH_STYLE=false

# --- Optional ---
# The Sanning address; the API key decides Sandbox or Live.
# SANNING_BASE_URL=https://api.sanning.io
# The port a service listens on (defaults: 8001, 8002, 8003); set it in the service's own file.
# PORT=8001
# Where an agent keeps its cases.
# RUNS_DIR=./runs/underwriter
# Where each agent finds the others; `credit-demo` fills these in for the local ports.
# CHECKER_URL=http://localhost:8002
# EVIDENCE_BUILDER_URL=http://localhost:8003
# DESK_URL=http://localhost:8001
# The interface the services listen on; no endpoint takes credentials, so widen it only behind something that authenticates.
# CREDIT_DEMO_HOST=127.0.0.1
# The folder holding applications/ and policy/; unset, it is this checkout.
# CREDIT_DEMO_HOME=
