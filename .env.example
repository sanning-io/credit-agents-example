# On your machine, each agent reads two files: this one, `.env`, which holds
# the settings both agents use, and its own, `underwriter.env` or
# `checker.env`, which hold the settings that differ (the layout is at the
# end of this file). Copy this file to `.env`, and never commit any of them.
# `credit-demo` checks every value before it starts, and names any that is
# missing or wrong. There is one block for each setup.
#
# On a host, each agent is its own service and gets every setting from the
# host, under these same names; the files are not used.

# --- On your machine ---
# Explained in README.md, "On your machine".

# A Sandbox API key (starts with `sanning_test_`), from the console's Settings,
# API keys.
SANNING_API_KEY=

# The model, through OpenRouter. It must support tool calls.
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-5

# --- In your cloud, as a test ---
# Explained in README.md, "In your cloud, as a test". Keep everything above,
# and add these. The names are those in
# https://docs.sanning.io/quickstart#set-up-your-log-store

# The bucket's name.
# SANNING_LOG_BUCKET=
# Amazon S3: the bucket's region. Cloudflare R2: `auto`.
# AWS_REGION=
# Cloudflare R2 only: https://ACCOUNT_ID.r2.cloudflarestorage.com. Leave it
# unset on Amazon S3.
# AWS_ENDPOINT_URL_S3=
# Keys that can create and write to the bucket.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Live ---
# Explained in README.md, "Live". Change these, and leave nothing from the
# Sandbox in place:
#
#   SANNING_API_KEY       the Live key (starts with `sanning_prod_`)
#   SANNING_SIGNING_SEED  two fresh seeds, not the Sandbox ones
#   SANNING_AGENT_ID      your own Live names, not the Sandbox ones
#   SANNING_LOG_BUCKET    a bucket of its own. A Live key with no bucket name
#                         stops the start-up.

# --- Optional ---

# Leave this unset: the API key decides. A `sanning_test_` key records to
# the sandbox and a `sanning_prod_` key to production. A value that
# disagrees with the key stops the start-up.
# SANNING_ENVIRONMENT=
SANNING_BASE_URL=https://api.sanning.io
# Any OpenAI-compatible service works here.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SANNING_S3_PATH_STYLE=false

# The port an agent listens on. Put it in the agent's own file, or let the host
# set it. Without one, the underwriter listens on 8001 and the checker on 8002.
# PORT=8001

# Where an agent keeps its cases: a folder inside the home below. A Sandbox
# agent's content sits in `logstore` inside it.
# RUNS_DIR=./runs/underwriter

# On a host, where the underwriter finds the checker, and where the checker
# asks the credit desk for a case's documents. On your machine `credit-demo`
# fills in both for the two local ports.
# CHECKER_URL=http://localhost:8002
# DESK_URL=http://localhost:8001

# The agents listen on 127.0.0.1, and no endpoint takes credentials. Put
# something that authenticates in front before you widen this. The image sets
# 0.0.0.0, and the checker must have no public address.
# CREDIT_DEMO_HOST=127.0.0.1

# The folder holding applications/ and policy/. Unset, it is this checkout.
# CREDIT_DEMO_HOME=

# --- The two agent files ---
# `credit-demo keys` creates both with a fresh signing seed. Each agent's own
# file holds:
#
#   underwriter.env                          checker.env
#   SANNING_AGENT_ID=underwriter-sandbox     SANNING_AGENT_ID=checker-sandbox
#   SANNING_SIGNING_SEED=<seed>              SANNING_SIGNING_SEED=<seed>
#   COUNTERPARTY_PUBLIC_KEY=<checker's key>  COUNTERPARTY_PUBLIC_KEY=<underwriter's key>
#
# A Sandbox agent is a separate identity from a Live one. On your machine,
# `credit-demo` derives a COUNTERPARTY_PUBLIC_KEY you leave out from the other
# agent's seed. On two hosts, set each to the other agent's public_key from
# its /health, or to the public key `credit-demo keys` prints.
