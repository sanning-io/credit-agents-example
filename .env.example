# On your machine, each agent reads two files: this one, `.env`, which holds
# the settings both agents use, and its own, `underwriter.env` or
# `checker.env`, which hold the settings that differ (the layout is at the
# end of this file). The evidence builder reads one file of its own,
# `evidence-builder.env`, and never this one: this file holds the agents'
# API key and bucket keys, which can write. Copy this file to `.env`, and never
# commit any of them. `credit-demo` checks every value before it starts, and
# names any that is missing or wrong. There is one block for each setup.
#
# On a host, each service is its own service and gets every setting from the
# host, under these same names; the files are not used.

# --- On your machine ---
# Explained in README.md, "On your machine".

# A Sandbox API key (starts with `sanning_test_`), from the console's Settings,
# API keys.
SANNING_API_KEY=

# The model, through OpenRouter. It must support tool calls.
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-5

# --- In your cloud, as a test ---
# Explained in README.md, "In your cloud, as a test". Keep everything above,
# and add these. The names are those in
# https://docs.sanning.io/quickstart#set-up-your-log-store

# One bucket for both agents; each writes under a folder named after its
# agent ID. Sanning supports AWS S3 today.
# SANNING_LOG_BUCKET=
# The bucket's region.
# AWS_REGION=
# Leave this unset on Amazon S3.
# AWS_ENDPOINT_URL_S3=
# Keys that can create and write to the bucket.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Live ---
# Explained in README.md, "Live". Change these, and leave nothing from the
# Sandbox in place:
#
#   SANNING_API_KEY       the Live key (starts with `sanning_prod_`)
#   SANNING_SIGNING_SEED  two fresh seeds, not the Sandbox ones
#   SANNING_AGENT_ID      your own Live names, not the Sandbox ones
#   SANNING_LOG_BUCKET    a bucket of its own. A Live key with no bucket name
#                         stops the start-up.

# --- Optional ---

# Leave this unset: the API key decides. A `sanning_test_` key records to
# the sandbox and a `sanning_prod_` key to production. A value that
# disagrees with the key stops the start-up.
# SANNING_ENVIRONMENT=
SANNING_BASE_URL=https://api.sanning.io
# Any OpenAI-compatible service works here.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set this to true to make recording use path-style bucket addresses
# (https://host/bucket) on Amazon S3. With AWS_ENDPOINT_URL_S3 set, the
# SDK already uses them. `bundle` always does, and has no setting for it.
# SANNING_S3_PATH_STYLE=false

# The port a service listens on. Put it in the service's own file, or let the
# host set it. Without one, the underwriter listens on 8001, the checker on
# port 8002 and the evidence builder on port 8003.
# PORT=8001

# Where an agent keeps its cases: a folder inside the home below. A Sandbox
# agent's content sits in `logstore/AGENT_ID`, beside the agents' case folders.
# RUNS_DIR=./runs/underwriter

# On a host, where the underwriter finds the checker and the evidence builder,
# and where the checker asks the credit desk for a case's documents. On your
# machine `credit-demo` fills in all three for the local ports.
# CHECKER_URL=http://localhost:8002
# EVIDENCE_BUILDER_URL=http://localhost:8003
# DESK_URL=http://localhost:8001

# The agents listen on 127.0.0.1, and no endpoint takes credentials. Put
# something that authenticates in front before you widen this. The image sets
# `::` (every interface, IPv4 and IPv6), and the checker and the evidence
# builder must have no public address.
# CREDIT_DEMO_HOST=127.0.0.1

# The folder holding applications/ and policy/. Unset, it is this checkout.
# CREDIT_DEMO_HOME=

# --- The two agent files ---
# `credit-demo keys` creates both with a fresh signing seed. Each agent's own
# file holds:
#
#   underwriter.env                          checker.env
#   SANNING_AGENT_ID=underwriter-sandbox     SANNING_AGENT_ID=checker-sandbox
#   SANNING_SIGNING_SEED=<seed>              SANNING_SIGNING_SEED=<seed>
#   COUNTERPARTY_PUBLIC_KEY=<checker's key>  COUNTERPARTY_PUBLIC_KEY=<underwriter's key>
#
# A Sandbox agent is a separate identity from a Live one. On your machine,
# `credit-demo` derives a COUNTERPARTY_PUBLIC_KEY you leave out from the other
# agent's seed. On two hosts, set each to the other agent's public_key from
# its /health, or to the public key `credit-demo keys` prints.

# --- The evidence builder's file ---
# `credit-demo keys` creates `evidence-builder.env` with a fresh hand-over seed.
# It builds the case file with the organization's hand-over key and holds no
# agent's seed. It never reads `.env`: its API key and its bucket keys are its
# own. Its file holds:
#
#   evidence-builder.env
#   SANNING_API_KEY=<its own key, with Hand-over>
#   SANNING_SIGNING_SEED=<the hand-over seed: openssl rand -hex 32>
#   SANNING_SIGNING_KEY_KIND=organization
#   UNDERWRITER_AGENT_ID=<the underwriter's SANNING_AGENT_ID>
#   CHECKER_AGENT_ID=<the checker's SANNING_AGENT_ID>
#
# With a bucket, add the bucket's name and region and keys of its own: the same
# names as above. The keys need `s3:GetObject` and `s3:PutObject` on the
# bucket's objects (it adds the declarations it signs to each agent's folder)
# and `s3:ListBucket` on the bucket, and nothing more.
#
#   SANNING_LOG_BUCKET, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   (and AWS_ENDPOINT_URL_S3 for a bucket that is not on Amazon S3)
