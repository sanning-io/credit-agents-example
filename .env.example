# Copy to .env and fill in the required values. Never commit .env.
# Both agents read this one file. `credit-demo` checks every value before it
# starts, and names any that is missing or wrong. There is one block for each
# setup.

# --- On your machine ---
# Explained in README.md, "On your machine".

# A Sandbox API key (starts with `sanning_test_`), from the console's Settings,
# API keys.
SANNING_API_KEY=

# The model, through OpenRouter. It must support tool calls.
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-5

# Each agent's own signing seed. `credit-demo keys >> .env` adds both.
UNDERWRITER_SANNING_SIGNING_SEED=
CHECKER_SANNING_SIGNING_SEED=

# Each agent's own ID. A Sandbox agent is a separate identity from a Live one.
UNDERWRITER_SANNING_AGENT_ID=underwriter-sandbox
CHECKER_SANNING_AGENT_ID=checker-sandbox

# --- In your cloud, as a test ---
# Explained in README.md, "In your cloud, as a test". Keep everything above,
# and add these. The names are those in
# https://docs.sanning.io/quickstart#set-up-your-log-store

# The bucket's name.
# SANNING_LOG_BUCKET=
# Amazon S3: the bucket's region. Cloudflare R2: `auto`.
# AWS_REGION=
# Cloudflare R2 only: https://ACCOUNT_ID.r2.cloudflarestorage.com. Leave it
# unset on Amazon S3.
# AWS_ENDPOINT_URL_S3=
# Keys that can create and write to the bucket.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Live ---
# Explained in README.md, "Live". Change these, and leave nothing from the
# Sandbox in place:
#
#   SANNING_API_KEY      the Live key (starts with `sanning_prod_`)
#   *_SIGNING_SEED       two fresh seeds, not the Sandbox ones
#   *_SANNING_AGENT_ID   remove both lines, or set your own Live names
#   SANNING_LOG_BUCKET   a bucket of its own. A Live key with no bucket name
#                        stops the start-up.

# --- Optional ---

# Leave this unset: the API key decides. A `sanning_test_` key records to
# the sandbox and a `sanning_prod_` key to production. A value that
# disagrees with the key stops the start-up.
# SANNING_ENVIRONMENT=
SANNING_BASE_URL=https://api.sanning.io
# Any OpenAI-compatible service works here.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SANNING_S3_PATH_STYLE=false

# Each agent's port.
# UNDERWRITER_PORT=8001
# CHECKER_PORT=8002

# Where each agent keeps its cases: a folder inside the home below. A Sandbox
# agent's content sits in `logstore` inside it.
# UNDERWRITER_RUNS_DIR=./runs/underwriter
# CHECKER_RUNS_DIR=./runs/checker

# One value for one agent only: prefix it with UNDERWRITER_ or CHECKER_, for
# example CHECKER_MODEL=... or CHECKER_BUCKET=... (the bucket settings take
# BUCKET, ENDPOINT, REGION, ACCESS_KEY_ID, SECRET_ACCESS_KEY, BUCKET_PATH_STYLE).

# Running the two agents on two machines: set each to the other agent's
# public_key from its /health. On one machine, leave them unset.
# UNDERWRITER_COUNTERPARTY_PUBLIC_KEY=
# CHECKER_COUNTERPARTY_PUBLIC_KEY=
# CHECKER_URL=http://localhost:8002
# Where the checker agent asks the credit desk for a case's documents.
# DESK_URL=http://localhost:8001

# The agents listen on 127.0.0.1, and no endpoint takes credentials. Put
# something that authenticates in front before you widen this.
# CREDIT_DEMO_HOST=127.0.0.1

# The folder holding applications/ and policy/. Unset, it is this checkout.
# CREDIT_DEMO_HOME=
